<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_project_view_form" model="ir.ui.view">
        <field name="name">hr.project.form</field>
        <field name="model">hr.project</field>
        <field name="arch" type="xml">
            <form string="Project">
                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Project Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Website Redesign"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" string="Customer"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tasks" name="tasks">
                            <field name="task_ids" mode="kanban"
                                   context="{'default_project_id': id}">
                                <kanban default_group_by="stage_id"
                                        group_create="true"
                                        records_draggable="true">
                                    <field name="stage_id"/>
                                    <field name="stage_color"/>
                                    <field name="activity_state"/>
                                    <templates>
                                        <t t-name="card">
                                            <field name="name" class="fw-bold fs-4"/>
                                            <div t-if="record.stage_id.raw_value"
                                                 class="mt-2">
                                                <span t-attf-class="badge rounded-pill #{record.stage_id.value == 'Completed' ? 'bg-success' : record.stage_id.value == 'Cancelled' ? 'bg-danger' : record.stage_id.value == 'Ongoing' ? 'bg-warning text-dark' : 'bg-white text-dark border'}">
                                                    <t t-esc="record.stage_id.value"/>
                                                </span>
                                            </div>
                                            <div t-if="record.date_deadline.raw_value"
                                                 class="text-muted">
                                                Deadline: <field name="date_deadline"/>
                                            </div>
                                            <footer>
                                                <field name="activity_ids" widget="kanban_activity"/>
                                                <field name="user_ids" widget="many2many_avatar_user"
                                                       class="ms-auto"/>
                                            </footer>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Describe the project..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_project_view_kanban" model="ir.ui.view">
        <field name="name">hr.project.kanban</field>
        <field name="model">hr.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" group_create="true" records_draggable="true">
                <field name="stage_id"/>
                <field name="activity_state"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-4"/>
                        <field name="partner_id" class="text-muted"/>
                        <div t-if="record.date_end.raw_value" class="text-muted">
                            Ends: <field name="date_end"/>
                        </div>
                        <footer>
                            <field name="activity_ids" widget="kanban_activity"/>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="hr_project_view_list" model="ir.ui.view">
        <field name="name">hr.project.list</field>
        <field name="model">hr.project</field>
        <field name="arch" type="xml">
            <list string="Projects">
                <field name="name"/>
                <field name="partner_id" string="Customer"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="date_start" optional="show"/>
                <field name="date_end" optional="show"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="stage_id"/>
            </list>
        </field>
    </record>

    <record id="hr_project_view_search" model="ir.ui.view">
        <field name="name">hr.project.search</field>
        <field name="model">hr.project</field>
        <field name="arch" type="xml">
            <search string="Projects">
                <field name="name"/>
                <field name="partner_id" string="Customer"/>
                <field name="user_id"/>
                <filter name="my_projects" string="My Projects" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_manager" string="Project Manager" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_project_action" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">hr.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first project</p>
            <p>Projects move through the stages New, Ongoing, Completed and Cancelled.</p>
        </field>
    </record>
</odoo>
