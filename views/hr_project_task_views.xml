<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== Manager views (full access) ===================== -->
    <record id="hr_project_task_view_form" model="ir.ui.view">
        <field name="name">hr.project.task.form</field>
        <field name="model">hr.project.task</field>
        <field name="arch" type="xml">
            <form string="Task">
                <header>
                    <field name="is_project_manager" invisible="1"/>
                    <button name="action_create_manpower_requirement"
                            string="Create Hiring Request" type="object"
                            class="btn-primary"
                            groups="hr_project.group_hr_project_hr"
                            invisible="is_project_manager or not hiring_required or manpower_requirement_id"/>
                    <button name="action_view_manpower_requirement"
                            string="View Hiring Request" type="object"
                            groups="hr_project.group_hr_project_hr"
                            invisible="is_project_manager or not manpower_requirement_id"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Task Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Prepare onboarding kit"
                                   readonly="not is_project_manager"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" groups="hr_project.group_hr_project_manager"/>
                            <field name="client_id" readonly="1"/>
                            <field name="hiring_required"/>
                            <field name="manpower_requirement_id" readonly="1"/>
                            <field name="user_ids" widget="many2many_avatar_user"
                                   readonly="not is_project_manager"/>
                            <field name="date_deadline" readonly="not is_project_manager"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="not is_project_manager"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Describe the task..."
                                   readonly="not is_project_manager"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_project_task_view_kanban" model="ir.ui.view">
        <field name="name">hr.project.task.kanban</field>
        <field name="model">hr.project.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" group_create="true" records_draggable="true">
                <field name="stage_id"/>
                <field name="client_id"/>
                <field name="activity_state"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-4"/>
                        <field name="client_id" class="text-muted"/>
                        <div t-if="record.date_deadline.raw_value" class="text-muted">
                            Deadline: <field name="date_deadline"/>
                        </div>
                        <footer>
                            <field name="activity_ids" widget="kanban_activity"/>
                            <field name="user_ids" widget="many2many_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="hr_project_task_view_list" model="ir.ui.view">
        <field name="name">hr.project.task.list</field>
        <field name="model">hr.project.task</field>
        <field name="arch" type="xml">
            <list string="Tasks">
                <field name="name"/>
                <field name="client_id" optional="show"/>
                <field name="user_ids" widget="many2many_avatar_user"/>
                <field name="date_deadline" optional="show"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="stage_id"/>
            </list>
        </field>
    </record>

    <record id="hr_project_task_view_search" model="ir.ui.view">
        <field name="name">hr.project.task.search</field>
        <field name="model">hr.project.task</field>
        <field name="arch" type="xml">
            <search string="Tasks">
                <field name="name"/>
                <field name="user_ids"/>
                <field name="stage_id"/>
                <filter name="my_tasks" string="My Tasks" domain="[('user_ids', 'in', uid)]"/>
                <filter name="unassigned" string="Unassigned" domain="[('user_ids', '=', False)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_assignee" string="Assignee" context="{'group_by': 'user_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_project_task_action" model="ir.actions.act_window">
        <field name="name">All Tasks</field>
        <field name="res_model">hr.project.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first task</p>
            <p>Add stages from the Configuration menu, then create tasks and assign them to users.</p>
        </field>
    </record>

    <!-- ===================== HR views (no create / delete / column edits) ===================== -->
    <record id="hr_project_task_view_kanban_my" model="ir.ui.view">
        <field name="name">hr.project.task.kanban.my</field>
        <field name="model">hr.project.task</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="hr_project_task_view_kanban"/>
        <field name="arch" type="xml">
            <kanban position="attributes">
                <attribute name="create">false</attribute>
                <attribute name="quick_create">false</attribute>
                <attribute name="group_create">false</attribute>
                <attribute name="group_edit">false</attribute>
                <attribute name="group_delete">false</attribute>
            </kanban>
        </field>
    </record>

    <record id="hr_project_task_view_list_my" model="ir.ui.view">
        <field name="name">hr.project.task.list.my</field>
        <field name="model">hr.project.task</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="hr_project_task_view_list"/>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="create">false</attribute>
                <attribute name="delete">false</attribute>
            </list>
        </field>
    </record>

    <record id="hr_project_task_view_form_my" model="ir.ui.view">
        <field name="name">hr.project.task.form.my</field>
        <field name="model">hr.project.task</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="hr_project_task_view_form"/>
        <field name="arch" type="xml">
            <form position="attributes">
                <attribute name="create">false</attribute>
                <attribute name="delete">false</attribute>
            </form>
        </field>
    </record>

    <record id="hr_project_task_my_action" model="ir.actions.act_window">
        <field name="name">My Tasks</field>
        <field name="res_model">hr.project.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('user_ids', 'in', uid)]</field>
        <field name="search_view_id" ref="hr_project_task_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No tasks assigned to you</p>
            <p>Tasks assigned to you by a project manager will appear here.</p>
        </field>
    </record>

    <record id="hr_project_task_my_action_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="hr_project_task_view_kanban_my"/>
        <field name="act_window_id" ref="hr_project_task_my_action"/>
    </record>
    <record id="hr_project_task_my_action_list" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="hr_project_task_view_list_my"/>
        <field name="act_window_id" ref="hr_project_task_my_action"/>
    </record>
    <record id="hr_project_task_my_action_form" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="hr_project_task_view_form_my"/>
        <field name="act_window_id" ref="hr_project_task_my_action"/>
    </record>
</odoo>
