<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Privilege (Odoo 19): groups the two roles under one entry in the user form -->
    <record id="res_groups_privilege_hr_project" model="res.groups.privilege">
        <field name="name">HR Project</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <!-- HR: sees the tasks assigned to them and can change their stage -->
    <record id="group_hr_project_hr" model="res.groups">
        <field name="name">HR</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_hr_project"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('manpower_requisition.group_hr'))]"/>
    </record>

    <!-- Project Manager: creates projects, tasks and stages -->
    <record id="group_hr_project_manager" model="res.groups">
        <field name="name">Project Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_hr_project"/>
        <field name="implied_ids" eval="[(4, ref('group_hr_project_hr'))]"/>
    </record>

    <!-- Record rules -->
    <record id="hr_project_task_rule_hr" model="ir.rule">
        <field name="name">HR Task: HR sees only tasks assigned to them</field>
        <field name="model_id" ref="model_hr_project_task"/>
        <field name="domain_force">[('user_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_hr_project_hr'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_project_task_rule_manager" model="ir.rule">
        <field name="name">HR Task: Project Manager sees all tasks</field>
        <field name="model_id" ref="model_hr_project_task"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_hr_project_manager'))]"/>
    </record>
</odoo>
